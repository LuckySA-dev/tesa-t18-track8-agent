# Copy to .env and fill in. Never commit .env.
# Market: train sandbox = port 8000 (key-train), competition = port 8001 (key-test) - see endpoint.txt
MARKET_URL=http://202.29.227.22:8000
TEAM_KEY=sk-T18-change-me

# LLM. Competition (stages 2-3): ONLY the event gateway (model event-llm, same key as the market).
# Any other LLM, including Ollama on this PC, during a scored stage = disqualified.
# 20 Nov stage settings: rules only (USE_LLM=0), STRATEGY=adaptive, TACTIC=1 (all tested on the live practice room)
USE_LLM=0
# editor = LLM edits the planner plan (default) · seller = LLM picks every offer
LLM_MODE=editor
LLM_BASE_URL=http://202.29.227.22:4000/v1
LLM_MODEL=event-llm
LLM_API_KEY=sk-T18-change-me
# Practice only: local Ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3.5:9b
# LLM_API_KEY=none
LLM_TIMEOUT=60
LLM_THINKING=0
# gateway context ~4,000 tokens (prompt + answer)
LLM_CONTEXT=4000
LLM_MAX_TOKENS=700

# ---- Strategy: PATTERN=0 (old planner + live priors). Stage 2 (18 Nov): PATTERN=1 priced Commercial too high
# live and sold 0 kg in R3-R4; PATTERN=0 sold 840 kg in R5-R7. See HANDOFF.md "Stage 2 result".
PATTERN=0
PATTERN_TOL=0.05
PRIORS_FILE=priors-live.json
# Optional: LLM randomness (default 0.7); lower = steadier answers. USE_LLM=0 = rules only (pattern).
# LLM_TEMPERATURE=0.3

# Tactic layer (tactic.py): per-buyer feedback on k, attack/normal/safe/rescue modes from the sell limit,
# LLM clamp, spread. Replica suite 19 Nov: better in 11/11 markets. 0 = old behaviour.
TACTIC=1

# STRATEGY=adaptive: price like the live practice room's winning adaptive bot (k per buyer type 1.12/1.00/0.90,
# +-0.01 per round on our results, 1.5 x even share per round); TACTIC=1 runs on top. Empty = planner.
STRATEGY=adaptive
# How sure the sample must make us that the TRUE lot passes a buyer's spec before offering (blind test: 0.5)
SPEC_P=0.5
# Idle capacity tries lots whose sample just misses a spec (pass chance 5 % .. SPEC_P)
FREE_TRY=1
